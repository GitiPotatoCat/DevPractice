@page "/404"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>404 - Page Not Found</PageTitle>

<div style="@pageContainerStyle">
    <!-- Smooth Ambient Depth Background Orbs -->
    <div style="@ambientGlowPrimaryStyle"></div>
    <div style="@ambientGlowSecondaryStyle"></div>
    <div style="@ambientGlowTertiaryStyle"></div>

    <!-- Main Glassmorphic Card Container -->
    <div style="@glassCardStyle">
        <!-- Top Refraction Specular Line -->
        <div style="@glassRefractionLineStyle"></div>

        <!-- Hero Image Frame with Pantone Gradient Glow Ring -->
        <div style="@imageFrameGlowWrapperStyle">
            <div style="@imageContainerStyle">
                <img src="@imagePath"
                     alt="404 Page Not Found"
                     style="@imageElementStyle" />

                <!-- Minimal Floating Status Badge -->
                <div style="@statusBadgeStyle">
                    <span style="@pulseDotStyle"></span>
                    <span>404 • UNMAPPED ROUTE</span>
                </div>
            </div>
        </div>

        <!-- Typography Content -->
        <h1 style="@headingStyle">Lost in the Workspace?</h1>
        <p style="@subheadingStyle">
            The task board, financial report, or actuarial resource you are searching for doesn't exist, was renamed, or has been relocated to another workspace.
        </p>

        <!-- Action Buttons Group -->
        <div style="@buttonGroupStyle">
            <button style="@primaryButtonStyle"
                    @onclick="GoHome"
                    @onmouseenter="() => _isPrimaryHovered = true"
                    @onmouseleave="() => _isPrimaryHovered = false">
                <i class="bi bi-grid-1x2-fill" style="font-size: 15px;"></i>
                <span>Back to Dashboard</span>
            </button>

            <button style="@secondaryButtonStyle"
                    @onclick="GoBack"
                    @onmouseenter="() => _isSecondaryHovered = true"
                    @onmouseleave="() => _isSecondaryHovered = false">
                <i class="bi bi-arrow-left-short" style="font-size: 20px; line-height: 1;"></i>
                <span>Previous Page</span>
            </button>
        </div>
    </div>
</div>

<style>
    @keyframeStyles
</style>

@code {
    private bool _isPrimaryHovered;
    private bool _isSecondaryHovered;

    // Dynamically resolve asset URL from static root
    private string imagePath => $"{Navigation.BaseUri}pagenotfound.png";

    // Compile-time constants
    private const string fontFamily = "'Quicksand', system-ui, -apple-system, sans-serif";

    // Pantone Color Tokens
    private const string slateBlack = "#1E232A";
    private const string slateGray = "#64748B";
    private const string pantoneLeafGreen = "#388E3C";
    private const string pantoneLimeGreen = "#7CB342";
    private const string pantoneLightGold = "#FBC02D";

    private const string pantoneTripleGradient = "linear-gradient(135deg, #388E3C 0%, #7CB342 50%, #FBC02D 100%)";

    private void GoHome() => Navigation.NavigateTo("/");
    private async Task GoBack() => await JSRuntime.InvokeVoidAsync("history.back");

    // Keyframe Animations
    private string keyframeStyles = @"
        @keyframes badgeRadarPulse {
            0% { box-shadow: 0 0 0 0 rgba(56, 142, 60, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(56, 142, 60, 0); }
            100% { box-shadow: 0 0 0 0 rgba(56, 142, 60, 0); }
        }
        @keyframes ambientFloatPrimary {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-25px, 18px) scale(1.04); }
        }
        @keyframes ambientFloatSecondary {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(25px, -20px) scale(1.06); }
        }
    ";

    // Layout Styles
    private string pageContainerStyle => $@"
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 70px);
        padding: 2rem;
        background-color: #F4F7F4;
        font-family: {fontFamily};
        color: {slateBlack};
        overflow: hidden;
    ";

    private string ambientGlowPrimaryStyle = "position: absolute; top: -120px; right: -80px; width: 550px; height: 550px; border-radius: 50%; background: radial-gradient(circle, rgba(124, 179, 66, 0.2) 0%, rgba(244, 247, 244, 0) 70%); pointer-events: none; z-index: 0; animation: ambientFloatPrimary 12s infinite ease-in-out;";
    private string ambientGlowSecondaryStyle = "position: absolute; bottom: -140px; left: -60px; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(251, 192, 45, 0.16) 0%, rgba(244, 247, 244, 0) 70%); pointer-events: none; z-index: 0; animation: ambientFloatSecondary 15s infinite ease-in-out;";
    private string ambientGlowTertiaryStyle = "position: absolute; top: 40%; left: -100px; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(93, 64, 55, 0.08) 0%, rgba(244, 247, 244, 0) 70%); pointer-events: none; z-index: 0;";

    // Glass Card Container
    private string glassCardStyle => $@"
        position: relative;
        z-index: 1;
        max-width: 580px;
        width: 100%;
        text-align: center;
        padding: 3rem 2.5rem;
        border-radius: 32px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(28px) saturate(180%);
        -webkit-backdrop-filter: blur(28px) saturate(180%);
        border: 1px solid rgba(56, 142, 60, 0.16);
        box-shadow: 0 24px 60px -16px rgba(56, 142, 60, 0.15), inset 0 1px 2px rgba(255, 255, 255, 1);
    ";

    private string glassRefractionLineStyle = "position: absolute; top: 0; left: 10%; right: 10%; height: 1.5px; background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.95) 50%, rgba(255,255,255,0) 100%); pointer-events: none;";

    // Image Container
    private string imageFrameGlowWrapperStyle => $@"
        position: relative;
        width: 100%;
        max-width: 420px;
        margin: 0 auto 2rem auto;
        padding: 3px;
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(56, 142, 60, 0.35) 0%, rgba(124, 179, 66, 0.2) 50%, rgba(251, 192, 45, 0.35) 100%);
        box-shadow: 0 16px 40px -10px rgba(56, 142, 60, 0.22);
    ";

    private string imageContainerStyle = $@"
        position: relative;
        width: 100%;
        height: 230px;
        border-radius: 21px;
        overflow: hidden;
        background: rgba(245, 248, 245, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
    ";

    private string imageElementStyle = "width: 100%; height: 100%; object-fit: cover; display: block;";

    // Status Pill Badge
    private string statusBadgeStyle => $@"
        position: absolute;
        top: 14px;
        right: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 99px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        font-size: 11px;
        font-weight: 800;
        color: {slateBlack};
        border: 1px solid rgba(255, 255, 255, 1);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        z-index: 3;
    ";

    private string pulseDotStyle => $"width: 7px; height: 7px; border-radius: 50%; background-color: {pantoneLeafGreen}; animation: badgeRadarPulse 2s infinite ease-in-out;";

    // Typography
    private string headingStyle => $@"
        font-size: 2.25rem;
        font-weight: 800;
        color: {slateBlack};
        margin: 0 0 0.75rem 0;
        letter-spacing: -0.5px;
        line-height: 1.2;
    ";

    private string subheadingStyle => $"font-size: 0.95rem; color: {slateGray}; font-weight: 600; line-height: 1.6; margin: 0 auto 2.25rem auto; max-width: 480px;";

    // Action Buttons
    private string buttonGroupStyle = "display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap;";

    private string primaryButtonStyle => $@"
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 28px;
        border-radius: 16px;
        border: none;
        background: {pantoneTripleGradient};
        color: {slateBlack};
        font-family: {fontFamily};
        font-weight: 800;
        font-size: 0.925rem;
        cursor: pointer;
        box-shadow: 0 8px 24px -4px rgba(56, 142, 60, 0.35);
        transform: {(_isPrimaryHovered ? "translateY(-2px) scale(1.02)" : "translateY(0) scale(1)")};
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    ";

    private string secondaryButtonStyle => $@"
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 13px 28px;
        border-radius: 16px;
        border: 1px solid rgba(56, 142, 60, 0.25);
        background: {(_isSecondaryHovered ? "rgba(56, 142, 60, 0.12)" : "rgba(255, 255, 255, 0.75)")};
        color: #5D4037;
        font-family: {fontFamily};
        font-weight: 800;
        font-size: 0.925rem;
        cursor: pointer;
        box-shadow: {(_isSecondaryHovered ? "0 8px 20px -4px rgba(93, 64, 55, 0.15)" : "0 2px 8px rgba(0,0,0,0.02)")};
        transform: {(_isSecondaryHovered ? "translateY(-2px) scale(1.02)" : "translateY(0) scale(1)")};
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    ";
}

