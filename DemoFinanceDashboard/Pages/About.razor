@page "/about"

<PageTitle>About Us - Task & Financial Intelligence</PageTitle>

<div style="@pageContainerStyle">
    <!-- Header Hero Section -->
    <header style="@headerSectionStyle">
        <span style="@badgeStyle">ABOUT OUR PLATFORM</span>
        <h1 style="@mainTitleStyle">Next-Generation Financial & Task Intelligence</h1>
        <p style="@subtitleStyle">
            We bridge enterprise-grade actuarial precision with effortless task execution. Our mission is to streamline complex workflows, portfolio management, and data analytics into one glassmorphic workspace.
        </p>
    </header>

    <!-- Key Impact Metrics (Row of 3 Glass Cards) -->
    <div style="@metricsGridStyle">
        <div style="@metricCardStyle">
            <div style="@glassRefractionStyle"></div>
            <div style="@metricNumberStyle">₹ 120M+</div>
            <div style="@metricLabelStyle">Capital Managed</div>
            <div style="@metricSubtextStyle">Processed across active portfolios</div>
        </div>

        <div style="@metricCardStyle">
            <div style="@glassRefractionStyle"></div>
            <div style="@metricNumberStyle">99.4%</div>
            <div style="@metricLabelStyle">Task Completion Velocity</div>
            <div style="@metricSubtextStyle">On-time milestone delivery</div>
        </div>

        <div style="@metricCardStyle">
            <div style="@glassRefractionStyle"></div>
            <div style="@metricNumberStyle">15K+</div>
            <div style="@metricLabelStyle">Active Entities</div>
            <div style="@metricSubtextStyle">Secured underwriting policies</div>
        </div>
    </div>

    <!-- Core Mission & Vision (2-Column Glassmorphic Section) -->
    <div style="@missionSectionGridStyle">
        <!-- Story Column -->
        <div style="@glassCardStyle">
            <div style="@glassRefractionStyle"></div>
            <h2 style="@cardTitleStyle">Our Story & Mission</h2>
            <p style="@bodyParagraphStyle">
                Founded with a vision to eliminate fragmented operational tools, our platform combines modern data analytics with real-time task management.
            </p>
            <p style="@bodyParagraphStyle">
                Whether monitoring regional disbursements via heatmap telemetry or tracking underwriting pipelines, we provide an intuitive UI crafted for high-performing teams.
            </p>
        </div>

        <!-- Pillars Column -->
        <div style="@glassCardStyle">
            <div style="@glassRefractionStyle"></div>
            <h2 style="@cardTitleStyle">Core Strategic Pillars</h2>

            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <div style="@pillarIconStyle">
                        <span class="bi bi-shield-check" style="color: #388E3C; font-size: 16px;"></span>
                    </div>
                    <div>
                        <div style="@pillarTitleStyle">Actuarial Precision</div>
                        <div style="@pillarDescStyle">Bank-grade security and automated risk compliance algorithms.</div>
                    </div>
                </div>

                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <div style="@pillarIconStyle">
                        <span class="bi bi-cpu" style="color: #7CB342; font-size: 16px;"></span>
                    </div>
                    <div>
                        <div style="@pillarTitleStyle">Real-Time Intelligence</div>
                        <div style="@pillarDescStyle">Dynamic SVG analytics and instant data synchronization across states.</div>
                    </div>
                </div>

                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <div style="@pillarIconStyle">
                        <span class="bi bi-layers-half" style="color: #FBC02D; font-size: 16px;"></span>
                    </div>
                    <div>
                        <div style="@pillarTitleStyle">Glassmorphic Simplicity</div>
                        <div style="@pillarDescStyle">Focused interfaces designed to minimize cognitive overload.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Values Section (3-Column Grid) -->
    <div style="margin-top: 2rem;">
        <h2 style="@sectionHeadingStyle">Our Values</h2>

        <div style="@valuesGridStyle">
            <div style="@valueCardStyle">
                <span class="bi bi-lightning-charge-fill" style="@valueIconStyle"></span>
                <h3 style="@valueTitleStyle">Speed & Agility</h3>
                <p style="@valueDescStyle">Sub-second UI responsiveness powered by standalone Blazor WebAssembly architecture.</p>
            </div>

            <div style="@valueCardStyle">
                <span class="bi bi-eye-fill" style="@valueIconStyle"></span>
                <h3 style="@valueTitleStyle">Transparency</h3>
                <p style="@valueDescStyle">Clear revenue distribution metrics, detailed time tracking, and explicit task priorities.</p>
            </div>

            <div style="@valueCardStyle">
                <span class="bi bi-graph-up-arrow" style="@valueIconStyle"></span>
                <h3 style="@valueTitleStyle">Continuous Improvement</h3>
                <p style="@valueDescStyle">Iterative workflow optimization based on direct operational feedback loops.</p>
            </div>
        </div>
    </div>

    <!-- Bottom Call To Action Banner -->
    <div style="@ctaBannerStyle">
        <div style="@glassRefractionStyle"></div>
        <div>
            <h3 style="@ctaHeadingStyle">Ready to Elevate Your Workspace?</h3>
            <p style="@ctaSubtextStyle">Explore the dashboard, review upcoming tasks, or track financial analytics in real-time.</p>
        </div>
        <NavLink href="dashboard" style="@ctaButtonStyle">
            <span>Explore Dashboard</span>
            <span class="bi bi-arrow-right" style="font-size: 16px;"></span>
        </NavLink>
    </div>
</div>

@code {
    private string fontFamily = "'Quicksand', system-ui, -apple-system, sans-serif";

    // Pantone Color Tokens
    private string slateBlack = "#1E232A";
    private string slateGray = "#64748B";
    private string pantoneTripleGradient = "linear-gradient(135deg, #388E3C 0%, #7CB342 50%, #FBC02D 100%)";

    // Container & Page Layout
    private string pageContainerStyle => $"max-width: 1350px; margin: 0 auto; padding: 1.5rem 0; font-family: {fontFamily}; color: {slateBlack};";

    // Header Hero Styles
    private string headerSectionStyle = "text-align: center; margin-bottom: 3rem; max-width: 800px; margin-left: auto; margin-right: auto;";
    private string badgeStyle => $"display: inline-block; padding: 6px 16px; border-radius: 99px; background: rgba(56, 142, 60, 0.12); color: #2E7D32; font-weight: 800; font-size: 11px; letter-spacing: 1px; margin-bottom: 1rem;";
    private string mainTitleStyle => $"font-size: 2.75rem; font-weight: 800; color: {slateBlack}; margin: 0 0 1rem 0; letter-spacing: -0.5px; line-height: 1.2;";
    private string subtitleStyle => $"font-size: 1.05rem; color: {slateGray}; line-height: 1.6; font-weight: 600; margin: 0;";

    // Impact Metric Cards
    private string metricsGridStyle = "display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem;";
    private string metricCardStyle => $@"
        position: relative;
        padding: 2rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(24px) saturate(180%);
        border: 1px solid rgba(56, 142, 60, 0.12);
        box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.04);
        text-align: center;
        overflow: hidden;
    ";
    private string metricNumberStyle => $@"
        font-size: 2.5rem;
        font-weight: 800;
        background: {pantoneTripleGradient};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.25rem;
        letter-spacing: -0.5px;
    ";
    private string metricLabelStyle => $"font-size: 1.1rem; font-weight: 800; color: {slateBlack}; margin-bottom: 0.25rem;";
    private string metricSubtextStyle => $"font-size: 0.85rem; color: {slateGray}; font-weight: 600;";

    // Mission & Vision Cards
    private string missionSectionGridStyle = "display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;";
    private string glassCardStyle => $@"
        position: relative;
        padding: 2.25rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(56, 142, 60, 0.12);
        box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    ";
    private string cardTitleStyle => $"font-size: 1.4rem; font-weight: 800; color: {slateBlack}; margin: 0 0 1rem 0;";
    private string bodyParagraphStyle => $"font-size: 0.95rem; color: {slateGray}; line-height: 1.6; font-weight: 600; margin-bottom: 1rem;";

    private string pillarIconStyle = "width: 36px; height: 36px; border-radius: 10px; background: rgba(56, 142, 60, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;";
    private string pillarTitleStyle => $"font-size: 1rem; font-weight: 800; color: {slateBlack};";
    private string pillarDescStyle => $"font-size: 0.85rem; color: {slateGray}; font-weight: 600; line-height: 1.4; margin-top: 2px;";

    // Values Grid
    private string sectionHeadingStyle => $"font-size: 1.75rem; font-weight: 800; color: {slateBlack}; margin-bottom: 1.25rem;";
    private string valuesGridStyle = "display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;";
    private string valueCardStyle => $"padding: 1.75rem; border-radius: 20px; background: rgba(245, 248, 245, 0.7); border: 1px solid rgba(56, 142, 60, 0.08);";
    private string valueIconStyle = "font-size: 24px; color: #388E3C; margin-bottom: 0.75rem; display: inline-block;";
    private string valueTitleStyle => $"font-size: 1.1rem; font-weight: 800; color: {slateBlack}; margin: 0 0 0.5rem 0;";
    private string valueDescStyle => $"font-size: 0.875rem; color: {slateGray}; font-weight: 600; line-height: 1.5; margin: 0;";

    // CTA Banner
    private string ctaBannerStyle => $@"
        position: relative;
        margin-top: 3rem;
        padding: 2.25rem 3rem;
        border-radius: 24px;
        background: {pantoneTripleGradient};
        color: {slateBlack};
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 12px 36px -6px rgba(56, 142, 60, 0.3);
        overflow: hidden;
    ";
    private string glassRefractionStyle = "position: absolute; top: 0; left: 10%; right: 10%; height: 1.5px; background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.95) 50%, rgba(255,255,255,0) 100%); pointer-events: none;";
    private string ctaHeadingStyle => $"font-size: 1.5rem; font-weight: 800; color: {slateBlack}; margin: 0 0 0.25rem 0;";
    private string ctaSubtextStyle => $"font-size: 0.95rem; font-weight: 700; color: rgba(30, 35, 42, 0.8); margin: 0;";
    private string ctaButtonStyle => $@"
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        border-radius: 14px;
        background: #1E232A;
        color: #FFFFFF;
        text-decoration: none;
        font-family: {fontFamily};
        font-weight: 800;
        font-size: 0.9rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        white-space: nowrap;
    ";
}

